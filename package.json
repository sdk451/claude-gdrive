{
  "name": "gdrive-cowork-connector",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted remote MCP server + Cowork/Claude plugin for reliable Google Drive access.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"AGENTS.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:unit:ci": "vitest run --reporter=default --reporter=json --reporter=junit --outputFile.json=reports/vitest-unit.json --outputFile.junit=reports/vitest-unit-junit.xml",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "hono": "^4.6.14",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^9.1.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
