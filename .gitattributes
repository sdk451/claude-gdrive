# Bash hooks / helper scripts must stay LF for Git Bash on Windows.
*.sh text eol=lf

# Merge hygiene: narrative logs are high-churn and cause avoidable PR conflicts.
# When merging into main, keep the checked-out branch's version for these paths
# ("ours" during `git checkout main && git merge feature`).
# Story branches should not commit these files (see strip script + autonomous docs).
docs/diary/** merge=ours
docs/agent-audit/agent-audit.jsonl merge=ours
