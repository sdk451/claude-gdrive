{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "TodoWrite",
      "Task",
      "Agent",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "mcp__plugin_context-mode_context-mode__*",
      "Workflow"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard origin/*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(chmod 777 *)",
      "Bash(npm publish*)",
      "Bash(docker system prune*)",
      "Bash(* ~/.ssh/*)",
      "Bash(* ~/.aws/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.credentials.json)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/permissions-policy.json)",
      "Write(**/.claude/permissions-policy.json)",
      "Edit(**/.cursor/hooks/**)",
      "Write(**/.cursor/hooks/**)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env.*)",
      "PowerShell(Remove-Item * -Recurse -Force /)",
      "PowerShell(Remove-Item * -Recurse -Force ~)",
      "PowerShell(Set-ExecutionPolicy*)"
    ],
    "defaultMode": "default"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/block-dangerous.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/enforce-plan-mode.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/enforce-tokens.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/memory-phase-router.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/graphify-preflight.cjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/policy-gate.cjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/policy-gate.cjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/policy-gate.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/vibecop-lint.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/memori-session.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/verify-completion-promise.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .cursor/hooks/run-hook.cjs .cursor/hooks/memori-session.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/worktree-guard.cjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook claude-code sessionstart",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/scripts/validate-permission-config.cjs \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook claude-code precompact",
            "timeout": 60
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/policy-gate.cjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/policy-gate.cjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.cursor/hooks/policy-gate.cjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
